# Copy to .env and fill in. Never commit .env.
# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start while this is empty or still "change-me".
SECRET_KEY=change-me
# Set to 1 behind the HTTPS tunnel (cookie only sent over HTTPS). Keep 0 for plain-HTTP LAN tests.
COOKIE_SECURE=0
DATABASE_PATH=instance/graduapp.sqlite
CONTENT_DIR=content
ADMIN_PASSWORD=change-me
